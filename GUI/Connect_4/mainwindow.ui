    <property name="styleSheet">
     <string notr="true">QPushButton {
        background-color: transparent;
        color: white;
        border: 2px solid white;
        font-size: 20px;
        padding: 10px;
    }

    QPushButton:hover {
        background-color: rgba(255, 255, 255, 0.2);  /* Light hover effect */
        border-color: rgba(255, 255, 255, 0.5);  /* Slightly lighter border on hover */
    }

    QPushButton:pressed {
        background-color: rgba(255, 255, 255, 0.4);  /* Darker background on click */
        border-color: rgba(255, 255, 255, 0.7);  /* Lighter border on click */
    }

    QPushButton:focus {
        outline: none;  /* Remove focus outline */
    }</string>
    </property>
    <property name="text">
     <string>1P  👤</string>
