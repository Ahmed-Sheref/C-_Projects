    <property name="styleSheet">
     <string notr="true">QPushButton {
    background: white; /* Gradient from purple to blue */
    border: 2px solid transparent; /* Transparent border to show the glow effect */
    color: Black;
    font-size: 18px;
    font-weight: bold;
    border-radius: 50%; /* This makes the button circular */
    padding: 20px; /* Padding to make the button large enough for a circle */
    text-align: center;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease; /* Smooth transitions */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15); /* Subtle shadow for depth */
    width: 70px; /* Set the button width */
    height: 70px; /* Set the button height */
    line-height: 70px; /* Align the text or icon vertically */
}

/* Hover effect - Add glowing effect and a slight color change */
 QPushButton:hover {
        background-color: rgba(255, 255, 255, 0.2);  /* Light hover effect */
        border-color: rgba(255, 255, 255, 0.5);  /* Slightly lighter border on hover */
    }

    QPushButton:pressed {
        background-color: rgba(255, 255, 255, 0.4);  /* Darker background on click */
        border-color: rgba(255, 255, 255, 0.7);  /* Lighter border on click */
    }

    QPushButton:focus {
        outline: none;  /* Remove focus outline */
    }</string>
    </property>
