     <string notr="true">QTableWidget {
    background-color: black; /* Black background */
    gridline-color: white;  /* White gridlines */
    border: 2px solid white; /* White border around the table */
}

QHeaderView::section {
    background-color: black; /* Black background for headers */
    color: orange;           /* Text color in headers */
    border: 1px solid white; /* White border for headers */
}

QTableWidget::item {
    background-color: black; /* Black background for cells */
    color: white;            /* White text color for cells */
    border: 1px solid white; /* White border for each cell */
}
